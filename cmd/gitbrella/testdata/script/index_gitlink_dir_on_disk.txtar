# An index from before a submodule was added, brought back: the submodule's
# directory is on disk under the gitlink's name. That directory is the
# submodule itself, not a file replaced by a directory, so the commit that
# would delete the gitlink is blocked.
exec git init -q -b main up
exec sh -c 'cd up && echo u > u && git add u && git -c user.name=t -c user.email=t@example.invalid commit -q -m u'
exec git init -q -b main r
exec sh -c 'cd r && echo a > a && git add a && git -c protocol.file.allow=always submodule add -q "$WORK/up" ext && git rm -q --cached ext && git -c user.name=t -c user.email=t@example.invalid commit -q -m gitmodules'
cp r/.git/index old-index
exec sh -c 'cd r && git add ext && git -c user.name=t -c user.email=t@example.invalid commit -q -m sub'
cp hook r/.git/hooks/pre-commit
chmod 755 r/.git/hooks/pre-commit
cp old-index r/.git/index
exec sh -c 'echo e >> r/a'
exec git -C r add a
! exec git -C r -c user.name=t -c user.email=t@example.invalid commit -q -m oops
stderr 'DAMAGE INDEX_SHRUNK'
stderr 'sample: ext'

-- hook --
#!/bin/sh
exec gitbrella check
