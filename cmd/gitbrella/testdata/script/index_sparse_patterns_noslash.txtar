# Cone mode on, but the patterns file was written by hand without leading
# slashes or globs. git warns "disabling cone pattern matching" and matches
# the patterns as gitignore-style: only directories named src or docs are in
# the sparse set; README and a are not, and are not on disk. A lost index then
# drops README and a; the commit must be blocked.
[!git235] skip 'git before 2.35 matches these patterns differently in cone mode'
exec sh mk.sh r
exec git -C r sparse-checkout set --cone src docs
cp patterns r/.git/info/sparse-checkout
exec git -C r sparse-checkout reapply
! exists r/README
cp hook r/.git/hooks/pre-commit
chmod 755 r/.git/hooks/pre-commit
rm r/.git/index
exec git -C r add -A
exec sh -c 'echo e >> r/src/f1'
exec git -C r add src
! exec git -C r -c user.name=t -c user.email=t@example.invalid commit -q -m oops
stderr 'DAMAGE INDEX_SHRUNK'
stderr 'README'

-- patterns --
src/
docs/
-- mk.sh --
set -e
git init -q -b main "$1"
mkdir -p "$1/src" "$1/docs"
for i in 1 2 3; do echo "$i" > "$1/src/f$i"; echo "$i" > "$1/docs/d$i.md"; done
echo a > "$1/a"; echo r > "$1/README"
git -C "$1" add -A
git -C "$1" -c user.name=t -c user.email=t@example.invalid commit -q -m init
-- hook --
#!/bin/sh
exec gitbrella check
