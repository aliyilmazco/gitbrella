# A commit must not record as deleted a file that is still on disk. After a
# sync client deleted the index, staging some files builds a smaller new one,
# and committing it deletes the rest. Any HEAD file the index no longer lists
# while it is still in the working tree blocks the commit; to stop tracking
# a file on purpose, commit with --no-verify.
exec sh mk.sh r
cp hook r/.git/hooks/pre-commit
chmod 755 r/.git/hooks/pre-commit
env C='-c user.name=t -c user.email=t@example.invalid'

# index lost, one new file staged
rm r/.git/index
cp files/new r/new.txt
exec git -C r add new.txt
! exec sh -c 'git -C r $C commit -q -m oops'
stderr 'DAMAGE INDEX_SHRUNK'
stderr 'dropped: 10'
exec git -C r ls-tree -r --name-only HEAD
stdout '^src/f9$'
exec git -C r reset -q

# index lost, a directory staged again: a smaller loss
rm r/.git/index
exec git -C r add src
! exec sh -c 'git -C r $C commit -q -m oops'
stderr 'DAMAGE INDEX_SHRUNK'
stderr 'dropped: 1'
exec git -C r reset -q

# ignored files that were force-added are lost by add -A too
exec sh -c 'cd r && echo dist/ > .gitignore && mkdir dist && echo 1 > dist/b1 && echo 2 > dist/b2 && git add .gitignore && git add -f dist && git $C commit -q --no-verify -m dist'
rm r/.git/index
exec git -C r add -A
! exec sh -c 'git -C r $C commit -q -m oops'
stderr 'DAMAGE INDEX_SHRUNK'
stderr 'dist/b1'
exec git -C r reset -q

# untracking a file on purpose takes --no-verify, and the message says so
exec git -C r rm -q --cached src/f1
! exec sh -c 'git -C r $C commit -q -m untrack'
stderr 'DAMAGE INDEX_SHRUNK'
stderr 'no-verify'
exec sh -c 'git -C r $C commit -q --no-verify -m untrack'

# renaming a directory, and deleting everything on purpose: allowed
exec git -C r mv src lib
exec sh -c 'git -C r $C commit -q -m rename'
! stderr 'INDEX_SHRUNK'

# a directory replaced by a symlink to the same files: allowed
exec sh -c 'cd r && mv lib ../libstore && ln -s ../libstore lib && git rm -r -q --cached lib && git add lib && git $C commit -q -m link'
! stderr 'INDEX_SHRUNK'

# a vendored directory turned into a submodule: allowed
exec sh mk.sh up
exec sh -c 'cd r && mkdir vendor && cp ../up/a ../up/src/f1 vendor/ && git add vendor && git $C commit -q --no-verify -m vendor'
exec sh -c 'cd r && git rm -r -q --cached vendor && mv vendor ../vendor-old && git -c protocol.file.allow=always submodule add -q "$WORK/up" vendor && git $C commit -q -m submodule'
! stderr 'INDEX_SHRUNK'

exec git -C r rm -r -q :/
exec sh -c 'git -C r $C commit -q -m wipe'
! stderr 'INDEX_SHRUNK'

-- mk.sh --
set -e
git init -q -b main "$1"
mkdir -p "$1/src"
for i in 1 2 3 4 5 6 7 8 9; do echo "$i" > "$1/src/f$i"; done
echo a > "$1/a"
git -C "$1" add -A
git -C "$1" -c user.name=t -c user.email=t@example.invalid commit -q -m init
-- hook --
#!/bin/sh
exec gitbrella check
-- files/new --
new
